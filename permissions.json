{
  "_doc": "free-code互換のpermissionルール。deny=即拒否 / ask=Discordリアクション承認 / allow=明示許可。書式: \"Tool\" | \"Tool(完全一致)\" | \"Tool(プレフィクス:*)\" | \"Tool(glob*)\"。編集は再起動不要（mtimeで自動リロード）",
  "deny": [
    "Bash(git push --force:*)",
    "Bash(git push -f:*)",
    "Bash(git reset --hard:*)",
    "Bash(git clean -f:*)",
    "Bash(mkfs:*)",
    "Bash(dd if=:*)"
  ],
  "ask": [
    "Bash(rm -rf:*)",
    "Bash(sudo rm:*)",
    "Bash(git push:*)",
    "Bash(sudo systemctl stop:*)",
    "Bash(sudo systemctl disable:*)",
    "Bash(systemctl stop:*)",
    "Bash(shutdown:*)",
    "Bash(reboot:*)",
    "Bash(crontab:*)"
  ],
  "allow": []
}
