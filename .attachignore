# .attachignore — patterns for files that should NOT be attached to Discord
# Supports glob patterns (fnmatch) and matches against both full path and basename.
# One pattern per line. Lines starting with # are comments.

# Discord Bot — block source/config/secret files but allow render outputs.
# CLAUDE.md states "admin images: /home/ubuntu/ subdirs are OK to attach",
# so a blanket /home/ubuntu/discord-bot/* block contradicts that policy.
# We keep source code, env files, and caches blocked; render artefacts
# (e.g. /tmp/*) are already outside this tree and need no entry here.
/home/ubuntu/discord-bot/*.py
/home/ubuntu/discord-bot/*.sh
/home/ubuntu/discord-bot/*.json
/home/ubuntu/discord-bot/*.yml
/home/ubuntu/discord-bot/*.yaml
/home/ubuntu/discord-bot/*.toml
/home/ubuntu/discord-bot/.env*
/home/ubuntu/discord-bot/services/*
/home/ubuntu/discord-bot/utils/*
/home/ubuntu/discord-bot/tests/*
/home/ubuntu/discord-bot/scripts/*
/home/ubuntu/discord-bot/.claude/*
/home/ubuntu/discord-bot/.venv/*
/home/ubuntu/discord-bot/__pycache__/*

# News Curator
/home/ubuntu/news-curator/*

# Kanae Scheduler
/home/ubuntu/kanae-scheduler/*

# Kanae Contact
/home/ubuntu/kanae-contact/*

# Kanae Voice MCP
/home/ubuntu/kanae-voice-mcp/*

# Happy Server / Daemon
/home/ubuntu/happy-server/*

# English App
/home/ubuntu/english-app/*

# Scholarly MCP
/home/ubuntu/scholarly-mcp/*

# Free Code
/home/ubuntu/free-code/*
/home/ubuntu/free-code-cli/*

# Timetable API
/opt/timetable/*

# Cloudflared config
/etc/cloudflared/*

# Environment / secret files
.env
.env.*
*.env
.env.dev.enc
.env.prd.enc
credentials.json
*.key
*.pem
*.secret

# General: Python/Node source in service dirs
*.pyc
__pycache__/*
node_modules/*
.venv/*

# Backup files
*.bak
*.bak.*
*.backup
# Hidden credentials
/home/ubuntu/.claude/.credentials.json
/home/ubuntu/.config/gh/hosts.yml
.netrc
.pgpass
