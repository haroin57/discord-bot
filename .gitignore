.venv/
__pycache__/
*.pyc
.env
.state/
.claude/
.omc/
.env.example
.coverage

# Personal docs (private to haroin, not for repo)
docs/2026-06-08_*
docs/haroin_*
opencode.json

# Backup / scratch files that may contain prior secrets
*.bak
*.bak.*
*.backup
*.backup.*
*.old
*.orig
*.rej
*~

# Credential blobs (defense in depth; real path lives outside repo)
.credentials.json
credentials*.json
*.pem
*.key

# mitmproxy capture artifacts contain OAuth bearer tokens — never commit raw
# dumps. Only redacted JSON (produced by scripts/redact_capture.py) is safe.
*.mitm
docs/captures/**/*_raw.json
