[Unit]
Description=Kanae Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/discord-bot
EnvironmentFile=/home/ubuntu/discord-bot/.env
ExecStart=/home/ubuntu/discord-bot/.venv/bin/python /home/ubuntu/discord-bot/main_async.py
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=discord-bot

# Security hardening (audit 2026-05-13: H11)
NoNewPrivileges=yes
# PrivateTmp=no — bot writes /tmp/discord_bot_attachments etc. that need to be
# visible to the host (cleanup scripts, debugging, Discord attachment upload).
# Combined with ReadWritePaths on the same /tmp paths, PrivateTmp=yes triggers
# a status=226/NAMESPACE failure because the private /tmp doesn't contain
# those subdirectories at unit-spawn time.
PrivateTmp=no
ProtectSystem=strict
ProtectHome=read-only
# ReadWritePaths: allow writes to (a) the bot's own source/state dirs,
# (b) /tmp paths the bot renders into, AND (c) caches/configs that the
# Claude Code CLI subprocess + npx-launched MCP servers (brave-search,
# context7, playwright) need at runtime. Without .npm and .claude here,
# npm cache writes fail with EROFS, brave-search MCP cannot start, and
# Claude Code's plugin orphan cleanup fails — pushing the CLI to exit 1.
ReadWritePaths=/home/ubuntu/discord-bot /home/ubuntu/.local/state/discord-bot /home/ubuntu/.npm /home/ubuntu/.claude /home/ubuntu/.cache /tmp/discord_bot_attachments /tmp/mermaid_output /tmp/table_renders /tmp/math_renders
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
# MemoryDenyWriteExecute=no — claude_code_sdk spawns the Claude CLI as a
# subprocess (`node`), and V8's baseline JIT compiler requires
# write+execute mmap pages to generate code. With =yes set, Node dies
# with `Check failed: 12 == errno (ENOMEM)` deep inside
# v8::base::OS::SetPermissions, every claude_code_sdk.query() retry
# fails, and the bot ends up "running" but unable to talk to Claude.
MemoryDenyWriteExecute=no
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
