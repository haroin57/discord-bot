[Unit]
Description=Kanae Discord Bot
After=network-online.target
Wants=network-online.target
# SRE-C2: cap crash-loop retries to 3 per 60s; surface failure instead of
# infinite restart hammer.
StartLimitBurst=3
StartLimitIntervalSec=60
StartLimitAction=none

[Service]
Type=simple
User=kanae-bot
Group=kanae-bot
SupplementaryGroups=kanae-code
WorkingDirectory=/var/lib/discord-bot-releases/prod/current/src
EnvironmentFile=/etc/discord-bot/credentials/discord-bot.env
Environment=HOME=/var/lib/kanae-bot
Environment=BOT_STATE_DIR=/var/lib/kanae-bot/state
Environment=TMPDIR=/var/cache/kanae-bot
Environment=WRANGLER_CACHE_DIR=/var/cache/kanae-bot/wrangler
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CODEX_BIN=/home/ubuntu/.volta/tools/image/packages/@openai/codex/bin/codex
Environment=CODEX_APP_SERVER_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=R2_ARCHIVE_WRANGLER_BIN=/home/ubuntu/.volta/tools/image/packages/wrangler/lib/node_modules/wrangler/bin/wrangler.js
Environment=PYTHON_DOTENV_DISABLED=1
Environment=BOT_KEYWORDS=
Environment=WEB_API_HOST=127.0.0.1
Environment=WEB_API_PORT=3002
Environment=OAUTH_PRIMARY_CREDENTIALS_PATH=/var/lib/kanae-bot/.claude/.credentials.json
Environment=OAUTH_FAILOVER_CREDENTIALS_PATH=/var/lib/kanae-bot/.claude/.credentials-failover.json
Environment=OAUTH_FAILOVER_ENABLED=true
Environment=BOT_RELEASE_ROOT=/var/lib/discord-bot-releases/prod
Environment=BOT_RELEASE_METADATA_PATH=/var/lib/discord-bot-releases/prod/current/release.json
Environment=BOT_RELEASE_METADATA_OWNER=root
StateDirectory=kanae-bot kanae-bot/state
StateDirectoryMode=0700
CacheDirectory=kanae-bot
CacheDirectoryMode=0700
ExecStart=/var/lib/discord-bot-releases/prod/current/venv/bin/python /var/lib/discord-bot-releases/prod/current/src/main_async.py
Restart=on-failure
RestartSec=10s
# Keep systemd from sending SIGKILL before the application-level 1800-second
# in-flight Discord turn drain and final resource cleanup have completed.
TimeoutStopSec=1980s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=discord-bot
UMask=0007

# Security hardening (audit 2026-05-13: H11)
NoNewPrivileges=yes
# PrivateTmp=no — bot writes /tmp/discord_bot_attachments etc. that need to be
# visible to the host (cleanup scripts, debugging, Discord attachment upload).
# Combined with ReadWritePaths on the same /tmp paths, PrivateTmp=yes triggers
# a status=226/NAMESPACE failure because the private /tmp doesn't contain
# those subdirectories at unit-spawn time.
PrivateTmp=no
ProtectSystem=strict
ProtectHome=read-only
# Source and .git remain read-only. Runtime state is private to kanae-bot.
ReadWritePaths=/var/lib/kanae-bot /var/cache/kanae-bot /tmp/discord_bot_attachments /tmp/mermaid_output /tmp/table_renders /tmp/math_renders
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
# MemoryDenyWriteExecute=no — claude_code_sdk spawns the Claude CLI as a
# subprocess (`node`), and V8's baseline JIT compiler requires
# write+execute mmap pages to generate code. With =yes set, Node dies
# with `Check failed: 12 == errno (ENOMEM)` deep inside
# v8::base::OS::SetPermissions, every claude_code_sdk.query() retry
# fails, and the bot ends up "running" but unable to talk to Claude.
MemoryDenyWriteExecute=no
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

# SRE-H8: cap memory at 1700MB on 2GB host; trigger cgroup reclaim at 1500MB
# before OOM kill, giving the bot a chance to shed Puppeteer/MCP children.
MemoryMax=1700M
MemoryHigh=1500M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
