[Unit]
Description=Kanae Intervention Alert Scheduler (30分ごとに為替介入スコアリング, ADR-0027)
After=network-online.target
Wants=network-online.target
# crash-loop を 3回/60s で頭打ち (discord-bot.service / vi-signal-scheduler と同方針)
StartLimitBurst=3
StartLimitIntervalSec=60
StartLimitAction=none

[Service]
Type=simple
User=kanae-intervention
Group=kanae-intervention
SupplementaryGroups=kanae-code
WorkingDirectory=/var/lib/discord-bot-releases/prod/current/src
EnvironmentFile=/etc/discord-bot/credentials/intervention.env
Environment=HOME=/var/lib/kanae-intervention
Environment=BOT_STATE_DIR=/var/lib/kanae-intervention/state
Environment=PYTHON_DOTENV_DISABLED=1
StateDirectory=kanae-intervention kanae-intervention/state
StateDirectoryMode=0700
# 30分境界・薄商い判定が datetime.now() 依存のため TZ を明示固定
Environment=TZ=Asia/Tokyo
ExecStart=/var/lib/discord-bot-releases/prod/current/venv/bin/python -m services.intervention_scheduler
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=intervention-scheduler
UMask=0007

# Security hardening (vi-signal-scheduler.service を踏襲)
NoNewPrivileges=yes
PrivateTmp=no
ProtectSystem=strict
ProtectHome=read-only
# Legacy .state paths are redirected inside this mount namespace to the
# scheduler's private state directory; no other service UID can replace them.
BindPaths=/var/lib/kanae-intervention/state:/var/lib/discord-bot-releases/prod/current/src/.state
ReadWritePaths=/var/lib/kanae-intervention
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

# 本体より軽量 (subprocess で intervention_alert.py を一瞬走らせるだけ)
MemoryMax=256M
MemoryHigh=200M
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
