[Unit]
Description=remote-opencode Discord Bot
After=network-online.target
Wants=network-online.target
StartLimitBurst=3
StartLimitIntervalSec=60
StartLimitAction=none

[Service]
Type=simple
User=kanae-opencode
Group=kanae-opencode
SupplementaryGroups=kanae-code
WorkingDirectory=/home/ubuntu
Environment=PATH=/home/ubuntu/.opencode/bin:/home/ubuntu/.volta/bin:/home/ubuntu/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/var/lib/kanae-opencode
EnvironmentFile=/etc/discord-bot/credentials/remote-opencode.env
StateDirectory=kanae-opencode
StateDirectoryMode=0700
CacheDirectory=kanae-opencode
CacheDirectoryMode=0700
ExecStart=/home/ubuntu/.volta/bin/remote-opencode start
Restart=always
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=remote-opencode
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/kanae-opencode /var/cache/kanae-opencode /tmp
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=1200M
MemoryHigh=700M
OOMScoreAdjust=200
CPUWeight=50
IOWeight=50
LimitNOFILE=8192
TasksMax=200

[Install]
WantedBy=multi-user.target
