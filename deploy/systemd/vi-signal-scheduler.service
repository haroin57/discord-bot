[Unit]
Description=Kanae VI Signal Scheduler (毎営業日 18:00 JST に vi_signal_alert.py を実行)
After=network-online.target
Wants=network-online.target
# crash-loop を 3回/60s で頭打ちにし、無限再起動を防ぐ (discord-bot.service と同方針)
StartLimitBurst=3
StartLimitIntervalSec=60
StartLimitAction=none

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/discord-bot
EnvironmentFile=/home/ubuntu/discord-bot/.env
# 営業日・時刻判定が datetime.now() に依存するため TZ を明示固定する (機能8)
Environment=TZ=Asia/Tokyo
ExecStart=/home/ubuntu/discord-bot/.venv/bin/python -m services.vi_signal_scheduler
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vi-signal-scheduler

# Security hardening (discord-bot.service の H11 セットを踏襲、軽量化)
NoNewPrivileges=yes
PrivateTmp=no
ProtectSystem=strict
ProtectHome=read-only
# scheduler はリポジトリ配下 (.state/vi_signal_alert.log への追記) のみ書き込む。
# vi_signal_alert.py が市場データ取得で外部 HTTP を叩くだけなので /tmp や .npm は不要。
ReadWritePaths=/home/ubuntu/discord-bot
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

# 本体より軽量 (subprocess で vi_signal_alert.py を一瞬走らせるだけ)
MemoryMax=256M
MemoryHigh=200M
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
