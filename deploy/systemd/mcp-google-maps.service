[Unit]
Description=Shared MCP: google-maps (streamable HTTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/discord-bot
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.volta/tools/image/node/24.14.1/bin:/home/ubuntu/.volta/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/home/ubuntu/discord-bot/.env
ExecStart=/home/ubuntu/.volta/tools/image/node/24.14.1/bin/supergateway --stdio "npx -y @modelcontextprotocol/server-google-maps@0.6.2" --port 8025 --outputTransport streamableHttp --streamableHttpPath /mcp
Restart=on-failure
RestartSec=10s
MemoryHigh=200M
MemoryMax=256M
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
