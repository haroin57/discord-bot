[Unit]
Description=Hermes Discord Identity - Codex App Server Bot
After=network-online.target chromadb-server.service
Wants=network-online.target chromadb-server.service
StartLimitBurst=3
StartLimitIntervalSec=60
StartLimitAction=none

[Service]
Type=simple
User=kanae-hermes
Group=kanae-hermes
SupplementaryGroups=kanae-code
WorkingDirectory=/var/lib/discord-bot-releases/prod/current/src
EnvironmentFile=/etc/discord-bot/credentials/hermes-discord.env
Environment=HOME=/var/lib/kanae-hermes
Environment=BOT_STATE_DIR=/var/lib/kanae-hermes/state
Environment=TMPDIR=/var/cache/kanae-hermes
Environment=WRANGLER_CACHE_DIR=/var/cache/kanae-hermes/wrangler
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CODEX_BIN=/home/ubuntu/.volta/tools/image/packages/@openai/codex/bin/codex
Environment=CODEX_APP_SERVER_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=R2_ARCHIVE_WRANGLER_BIN=/home/ubuntu/.volta/tools/image/packages/wrangler/lib/node_modules/wrangler/bin/wrangler.js
Environment=PYTHON_DOTENV_DISABLED=1
Environment=WEB_API_HOST=127.0.0.1
Environment=WEB_API_PORT=3004
Environment=OAUTH_PRIMARY_CREDENTIALS_PATH=/var/lib/kanae-hermes/.claude/.credentials.json
Environment=OAUTH_FAILOVER_CREDENTIALS_PATH=/var/lib/kanae-hermes/.claude/.credentials-failover.json
Environment=OAUTH_FAILOVER_ENABLED=true
Environment=BOT_RELEASE_ROOT=/var/lib/discord-bot-releases/prod
Environment=BOT_RELEASE_METADATA_PATH=/var/lib/discord-bot-releases/prod/current/release.json
Environment=BOT_RELEASE_METADATA_OWNER=root
StateDirectory=kanae-hermes kanae-hermes/state
StateDirectoryMode=0700
CacheDirectory=kanae-hermes
CacheDirectoryMode=0700
ExecStart=/var/lib/discord-bot-releases/prod/current/venv/bin/python /var/lib/discord-bot-releases/prod/current/src/main_async.py
Restart=on-failure
RestartSec=10s
TimeoutStopSec=1980s
UMask=0007
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-discord-codex

NoNewPrivileges=yes
PrivateTmp=no
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/kanae-hermes /var/cache/kanae-hermes /tmp/discord_bot_attachments /tmp/mermaid_output /tmp/table_renders /tmp/math_renders
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

MemoryMax=900M
MemoryHigh=700M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
