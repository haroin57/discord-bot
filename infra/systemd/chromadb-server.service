[Unit]
Description=ChromaDB HTTP server (Mem0 backend)
Documentation=file:///home/ubuntu/discord-bot/docs/chromadb-server-mode-requirements.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kanae-chroma
Group=kanae-chroma
SupplementaryGroups=kanae-code
WorkingDirectory=/var/lib/discord-bot-releases/prod/current/src
Environment=HOME=/var/lib/kanae-chroma
StateDirectory=kanae-chroma
StateDirectoryMode=0700
CacheDirectory=kanae-chroma
CacheDirectoryMode=0700
ExecStart=/var/lib/discord-bot-releases/prod/current/venv/bin/chroma run --host 127.0.0.1 --port 8765 --path /var/lib/kanae-chroma/mem0_db
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chromadb-server
UMask=0007

# Resource limits per requirements §3.1.4. MemoryHigh = soft cap (cgroup reclaim
# pressure), MemoryMax = hard kill. Sized below the bot+MCP combined footprint
# from the SEGV incident, leaving headroom on the 2GB host.
MemoryHigh=250M
MemoryMax=400M
LimitNOFILE=4096

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/kanae-chroma /var/cache/kanae-chroma
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
