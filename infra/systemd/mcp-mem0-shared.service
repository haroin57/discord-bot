[Unit]
# Shared streamable-HTTP mem0 MCP. One daemon that every parallel Claude Code
# session connects to over 127.0.0.1:8013/mcp, instead of each `claude` CLI
# spawning its own ~280MB stdio child. (Phase 1.5 stdio dedup.)
Description=Shared MCP: mem0 (streamable HTTP, :8013)
Documentation=file:///home/ubuntu/discord-bot/CLAUDE.md
After=network-online.target chromadb-server.service
Wants=network-online.target
# mem0 reads/writes the ChromaDB served by chromadb-server; prefer it up first.
After=chromadb-server.service

[Service]
Type=simple
User=kanae-mem0
Group=kanae-mem0
SupplementaryGroups=kanae-code
WorkingDirectory=/var/lib/discord-bot-releases/prod/current/src
EnvironmentFile=/etc/discord-bot/credentials/mcp-mem0.env
Environment=HOME=/var/lib/kanae-mem0
Environment=BOT_STATE_DIR=/var/lib/kanae-mem0/state
Environment=MCP_HTTP_PORT=8013
Environment=PYTHON_DOTENV_DISABLED=1
StateDirectory=kanae-mem0 kanae-mem0/state
StateDirectoryMode=0700
CacheDirectory=kanae-mem0
CacheDirectoryMode=0700
ExecStart=/var/lib/discord-bot-releases/prod/current/venv/bin/python /var/lib/discord-bot-releases/prod/current/src/mcp_mem0_server.py
Restart=always
RestartSec=5
# Reap the whole cgroup (uvicorn workers, any thread pools) on stop/restart so
# we don't leak a half-dead listener holding :8013.
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-mem0-shared
UMask=0007

# Resource caps. MemoryHigh = soft (cgroup reclaim pressure), MemoryMax = hard
# kill. mem0 loads embeddings + the mem0 client; ~280MB observed as stdio child.
MemoryHigh=300M
MemoryMax=450M
LimitNOFILE=4096

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/kanae-mem0 /var/cache/kanae-mem0
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
