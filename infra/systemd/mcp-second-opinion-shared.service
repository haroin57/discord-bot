[Unit]
# Shared streamable-HTTP second-opinion MCP. One daemon on 127.0.0.1:8014/mcp
# for all parallel Claude Code sessions instead of a ~106MB stdio child each.
# (Phase 1.5 stdio dedup.)
Description=Shared MCP: second-opinion (streamable HTTP, :8014)
Documentation=file:///home/ubuntu/discord-bot/CLAUDE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kanae-second-opinion
Group=kanae-second-opinion
SupplementaryGroups=kanae-code
WorkingDirectory=/var/lib/discord-bot-releases/prod/current/src
EnvironmentFile=/etc/discord-bot/credentials/mcp-second-opinion.env
Environment=HOME=/var/lib/kanae-second-opinion
Environment=BOT_STATE_DIR=/var/lib/kanae-second-opinion/state
Environment=MCP_HTTP_PORT=8014
Environment=PYTHON_DOTENV_DISABLED=1
StateDirectory=kanae-second-opinion kanae-second-opinion/state
StateDirectoryMode=0700
CacheDirectory=kanae-second-opinion
CacheDirectoryMode=0700
ExecStart=/var/lib/discord-bot-releases/prod/current/venv/bin/python /var/lib/discord-bot-releases/prod/current/src/second_opinion_mcp_server.py
Restart=always
RestartSec=5
# Reap the whole cgroup: second_opinion shells out to agy/codex node CLIs; a
# control-group kill prevents orphaned child processes on restart.
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-second-opinion-shared
UMask=0007

# Resource caps. ~106MB observed as stdio child; short-lived child CLIs push
# transient peaks, so MemoryMax leaves headroom above the steady state.
MemoryHigh=200M
MemoryMax=300M
LimitNOFILE=4096

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/kanae-second-opinion /var/cache/kanae-second-opinion
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
