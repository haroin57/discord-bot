[Unit]
# Shared streamable-HTTP x-scraper MCP (FastMCP native HTTP) on
# 127.0.0.1:8016/mcp. One daemon for all parallel Claude Code sessions instead
# of a ~59MB stdio child each. (Phase 1.5 stdio dedup.)
Description=Shared MCP: x-scraper (streamable HTTP, :8016)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kanae-x-scraper
Group=kanae-x-scraper
SupplementaryGroups=kanae-code
# x-scraper lives outside the repo (free-code); its server adds ./src to
# sys.path relative to the file, so WorkingDirectory is its own root.
WorkingDirectory=/home/ubuntu/free-code/x-scraper
Environment=HOME=/var/lib/kanae-x-scraper
Environment=MCP_HTTP_PORT=8016
Environment=PYTHON_DOTENV_DISABLED=1
EnvironmentFile=/etc/discord-bot/credentials/mcp-x-scraper.env
StateDirectory=kanae-x-scraper
StateDirectoryMode=0700
CacheDirectory=kanae-x-scraper
CacheDirectoryMode=0700
ExecStart=/home/ubuntu/free-code/x-scraper/.venv/bin/python /home/ubuntu/free-code/x-scraper/mcp_server.py
Restart=always
RestartSec=5
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-x-scraper-shared
UMask=0077

# Resource caps. ~59MB observed as stdio child; scraping spins up async HTTP.
MemoryHigh=200M
MemoryMax=300M
LimitNOFILE=4096

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/kanae-x-scraper /var/cache/kanae-x-scraper
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
