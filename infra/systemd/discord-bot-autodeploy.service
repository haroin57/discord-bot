[Unit]
Description=Kanae Discord Bot — auto-deploy (prod, pull-based)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kanae-deploy
Group=kanae-deploy
SupplementaryGroups=kanae-code
WorkingDirectory=/var/lib/discord-bot-deploy/checkouts/prod
EnvironmentFile=/etc/discord-bot/credentials/deploy.env
Environment=HOME=/var/lib/discord-bot-deploy
Environment=AUTO_DEPLOY_STATE_DIR=/var/lib/discord-bot-deploy/prod
Environment=AUTO_DEPLOY_RELEASE_ROOT=/var/lib/discord-bot-releases/prod
Environment=AUTO_DEPLOY_DISABLED=0
Environment=AUTO_DEPLOY_TEST_MODE=0
Environment=AUTO_DEPLOY_PROFILE=core
Environment=AUTO_DEPLOY_BOT_DIR=/var/lib/discord-bot-deploy/checkouts/prod
Environment=AUTO_DEPLOY_SERVICE=discord-bot
Environment=AUTO_DEPLOY_CONSUMERS=discord-bot
Environment=AUTO_DEPLOY_READY_PORTS=3002
Environment=AUTO_DEPLOY_LIVENESS_URLS=
Environment=AUTO_DEPLOY_RELEASE_GATE=/var/lib/discord-bot-deploy/checkouts/prod/scripts/release_gate.sh
Environment=AUTO_DEPLOY_TRUSTED_ROLLBACK_RUNNER=/usr/local/libexec/discord-bot-rollback
Environment=AUTO_DEPLOY_RELEASE_PUBLISHER=/usr/local/libexec/discord-bot-release-publisher
Environment=AUTO_DEPLOY_PUBLISHER_USE_SUDO=1
Environment=AUTO_DEPLOY_GENERATION_OWNER_UID=0
StateDirectory=discord-bot-deploy
StateDirectoryMode=0700
ExecStart=/var/lib/discord-bot-deploy/checkouts/prod/scripts/auto_deploy.sh prod
StandardOutput=journal
StandardError=journal
SyslogIdentifier=discord-bot-autodeploy
# Allow only the coordinated release-consumer restart set configured in sudoers.
# NoNewPrivileges/RestrictSUIDSGID cannot be enabled while this legacy sudo
# boundary remains. All other compatible hardening is applied here.
# Source produced by git/pip must remain readable by kanae-code; deploy trust
# files are explicitly chmod 0600/0700 by the scripts.
UMask=0022
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/discord-bot-deploy /var/lib/discord-bot-releases/prod /var/lib/discord-bot-backup/release-gate
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
