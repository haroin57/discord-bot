[Unit]
# Shared oracle MCP. oracle-mcp is a node stdio server, so we can't do native
# HTTP the way the FastMCP servers do — supergateway bridges stdio->streamable
# HTTP on 127.0.0.1:8015/mcp. One daemon for all parallel Claude Code sessions
# instead of a ~104MB node child each. (Phase 1.5 stdio dedup.)
Description=Shared MCP: oracle (supergateway stdio->streamable HTTP, :8015)
Documentation=file:///home/ubuntu/discord-bot/docs/oracle_mcp.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kanae-oracle
Group=kanae-oracle
SupplementaryGroups=kanae-code
WorkingDirectory=/var/lib/discord-bot-releases/prod/current/src
EnvironmentFile=/etc/discord-bot/credentials/mcp-oracle.env
Environment=HOME=/var/lib/kanae-oracle
# volta node bin first so supergateway + the wrapped oracle-mcp resolve.
Environment=PATH=/home/ubuntu/.volta/tools/image/node/24.14.1/bin:/home/ubuntu/.volta/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHON_DOTENV_DISABLED=1
StateDirectory=kanae-oracle
StateDirectoryMode=0700
CacheDirectory=kanae-oracle
CacheDirectoryMode=0700
# The wrapper applies and verifies the loopback-bind patch before Node loads
# supergateway. Startup fails closed if the installed version is unpatched.
ExecStart=/var/lib/discord-bot-releases/prod/current/src/scripts/oracle_supergateway_launch.sh
Restart=always
RestartSec=10
# control-group kill so supergateway's wrapped bash -> oracle-mcp child chain
# gets fully reaped on restart (child-leak guard).
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-oracle-shared
UMask=0077

# Filesystem and kernel hardening. The installed Node packages are read-only;
# the launcher fails closed when the operator-installed loopback patch is absent.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/kanae-oracle /var/cache/kanae-oracle
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

# Resource cap. The stdio child was ~104MB, but running it under supergateway
# means two node runtimes (gateway + oracle-mcp) whose combined baseline heap
# measures ~215MB idle. Cap above that so we're not pinned at MemoryHigh with
# constant cgroup reclaim pressure; MemoryMax still hard-kills a runaway.
MemoryHigh=384M
MemoryMax=512M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
